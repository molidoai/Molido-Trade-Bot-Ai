# ============================================================
# Molido Trade Bot AI - Environment Variables Example
# Copy this file to .env and fill REAL values.
# NEVER commit the real .env file.
# ============================================================

APP_NAME=Molido Trade Bot AI
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-me-with-a-long-random-secret-key-32
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=molido
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_DB=molido_trading

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me-redis-password
REDIS_DB=0

# LIVE is on by design. Fill MT5 REAL credentials or the engine cannot send orders.
TRADING_ACCOUNT_MODE=REAL
MASTER_BOT_ENABLED=true

MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
MT5_DEMO_PATH=

MT5_PROP_LOGIN=
MT5_PROP_PASSWORD=
MT5_PROP_SERVER=
MT5_PROP_PATH=
PROP_FIRM_NAME=
PROP_PHASE=
PROP_ACCOUNT_SIZE=
PROP_MAX_DAILY_LOSS_PCT=5.0
PROP_MAX_TOTAL_DRAWDOWN_PCT=10.0
PROP_PROFIT_TARGET_PCT=

MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_REAL_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

DEFAULT_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.05
MAX_OPEN_POSITIONS=5

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
