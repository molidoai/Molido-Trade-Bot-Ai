# ============================================================
# Molido Trade Bot AI - Environment Variables Example
# Copy this file to .env and fill real values.
# NEVER commit the real .env file.
# ============================================================

# ---------- Application ----------
APP_NAME=Molido Trade Bot AI
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=molido
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=molido_trading

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Trading Environment ----------
# DEMO is the only safe default. REAL must never be auto-enabled.
TRADING_ACCOUNT_MODE=DEMO     # DEMO | REAL
MASTER_BOT_ENABLED=false      # MASTER ON/OFF switch (persisted)

# ---------- Broker (MT5) - DEMO ----------
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
MT5_DEMO_PATH=                # path to terminal64.exe if using Wine

# ---------- Broker (MT5) - REAL (leave empty until ready) ----------
MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_REAL_PATH=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=    # comma-separated

# ---------- Risk Defaults (can be overridden in DB) ----------
DEFAULT_RISK_PER_TRADE=0.005  # 0.5%
MAX_DAILY_LOSS=0.02           # 2%
MAX_DRAWDOWN=0.05             # 5%
MAX_OPEN_POSITIONS=5

# ---------- Monitoring ----------
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
