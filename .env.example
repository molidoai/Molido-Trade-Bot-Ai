# ============================================================
# Molido Trade Bot AI - Environment Variables Example
# Copy this file to .env and fill REAL values.
# NEVER commit the real .env file.
# ============================================================

APP_NAME=Molido Trade Bot AI
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-me-with-a-long-random-secret-key-32
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=molido
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_DB=molido_trading

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me-redis-password
REDIS_DB=0

# Engine default is DEMO. Switch LIVE/REAL from the site Settings page.
TRADING_ACCOUNT_MODE=DEMO
MASTER_BOT_ENABLED=true

MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
MT5_DEMO_PATH=

MT5_PROP_LOGIN=
MT5_PROP_PASSWORD=
MT5_PROP_SERVER=
MT5_PROP_PATH=
PROP_FIRM_NAME=
PROP_PHASE=
PROP_ACCOUNT_SIZE=
PROP_MAX_DAILY_LOSS_PCT=5.0
PROP_MAX_TOTAL_DRAWDOWN_PCT=10.0
PROP_PROFIT_TARGET_PCT=

MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_REAL_PATH=

# Linux engine → Wine MT5 via mt5linux (no secrets here)
MT5_RPC_HOST=host.docker.internal
MT5_RPC_PORT=8001
MT5_LATENCY_HOST=host.docker.internal
MT5_LATENCY_PORT=8001

# Optional public JSON/iCal calendar. Empty → static 14-day high-impact table.
NEWS_CALENDAR_URL=
NEWS_CALENDAR_PATH=/app/data/news_calendar.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: admin JWT so /flatten and /off hit the API
MOLIDO_API_URL=http://api:8000/api/v1
MOLIDO_API_TOKEN=

DEFAULT_RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.04
MAX_OPEN_POSITIONS=3

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
